# Ambiente exclusivo do Compose DF-e. Copie para packages/dfe/.env.
DFE_PORT=8002
DFE_IMAGE=dfe-copilot:local
# 0: modelos sob demanda; 1: incorpora modelos durante o build.
DFE_PRELOAD_MODELS=0
DFE_OLLAMA_HOST=http://host.docker.internal:11434
DFE_LLM_MODEL=qwen3.6:35b-a3b
DFE_EMBEDDING_MODEL=nomic-embed-text
# Usuário bootstrap: usuario:hash PBKDF2 gerado pelo core.
DFE_WEB_UI_USERS=""
# Configure segredo estável para manter sessões entre reinícios.
DFE_SESSION_COOKIE_NAME=dfe_container_session
DFE_SESSION_SECRET=""
DFE_REQUIRE_AUTH=false
DFE_API_KEY=""
DFE_A2A_API_KEY=""
DFE_EVENT_MESH_API_KEY=""
DFE_ADMIN_API_KEY=""

# Modo compose.existing.yaml (rede/URL são obrigatórias nesse modo).
DFE_EXISTING_NETWORK=""
DFE_EXISTING_QDRANT_URL=""
# Caminho absoluto para snapshot BM25 existente, montado somente para leitura.
# DFE_BM25_CACHE_PATH=/caminho/para/bm25
DFE_EXISTING_EMBEDDING_MODEL=""
# DFE_HF_CACHE_PATH=/caminho/para/huggingface
