   "title": "Últimos 20 incidentes com sistema e verificação",
   "description": "Mesma correlação da tela /admin/incidents (DA-50): o cliente informa connector_source_system = system_key",
   "type": "table",
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres_iic"
     },
     "rawSql": "SELECT LEFT(i.id::text, 8) AS id, i.created_at AS \"Criado Em\", i.interface_type,\n                    i.connector_source_system AS origem,\n                    COALESCE(s.name, '—') AS sistema, COALESCE(s.status, '—') AS status_sistema,\n                    LEFT(COALESCE(i.probable_root_cause, '-'), 70) AS causa,\n                    i.diagnosis_confidence, i.evidence_strength, i.llm_provider_used, i.latency_ms,\n                    CASE WHEN i.diagnosis_correct IS NULL THEN '⏳'\n                         WHEN i.diagnosis_correct THEN '✅' ELSE '❌' END AS verificado\n             FROM incidents i\n             LEFT JOIN integration_systems s ON s.system_key = i.connector_source_system\n             WHERE i.created_at >= NOW() - INTERVAL '7 days'\n             ORDER BY i.created_at DESC LIMIT 20",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {},
      "indexByName": {},
      "renameByName": {}
     }
    }
