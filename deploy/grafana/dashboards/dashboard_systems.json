   "title": "Sistemas do catálogo × volume de incidentes (7d)",
   "description": "Visão operacional: cada sistema do catálogo com o volume de incidentes da última semana e o mais recente",
   "type": "table",
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres_iic"
     },
     "rawSql": "SELECT s.system_key, s.name, s.vendor, s.connector_type, s.environment, s.status,\n                    COUNT(i.id) FILTER (WHERE i.created_at >= NOW() - INTERVAL '7 days') AS incidentes_7d,\n                    MAX(i.created_at) AS ultimo_incidente\n             FROM integration_systems s\n             LEFT JOIN incidents i\n               ON (i.connector_source_system = s.system_key OR i.interface_type = s.connector_type)\n              AND i.created_at >= NOW() - INTERVAL '7 days'\n             GROUP BY 1, 2, 3, 4, 5, 6\n             ORDER BY 7 DESC, 1",
     "format": "table"
    }
   ],
   "transformations": [
