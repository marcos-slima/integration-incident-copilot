   "title": "Incidentes por status do sistema do catálogo",
   "description": "Correlação por conector (DA-50): interface_type = integration_systems.connector_type. Quando há mais de um sistema do mesmo tipo, o incidente é ambíguo e aparece aqui como 'sem correspondência' — a resolução por ambiente fica para o operador via /admin/incidents",
   "type": "barchart",
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres_iic"
     },
     "rawSql": "SELECT COALESCE(s.status, 'sem correspondência') AS status_sistema, COUNT(i.id) AS incidentes\n                FROM incidents i\n                LEFT JOIN integration_systems s ON s.connector_type = i.interface_type\n                WHERE i.created_at >= NOW() - INTERVAL '24 hours'\n                GROUP BY 1 ORDER BY 2 DESC",
     "format": "table"
    }
   ]
