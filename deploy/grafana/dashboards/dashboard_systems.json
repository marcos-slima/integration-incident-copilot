   "title": "Incidentes por sistema do catálogo (24h)",
   "description": "Match exato (DA-50): connector_source_system = integration_systems.system_key",
   "type": "barchart",
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres_iic"
     },
     "rawSql": "SELECT COALESCE(s.name || ' (' || s.system_key || ')', 'sem sistema') AS sistema, COUNT(i.id) AS incidentes\n                FROM incidents i\n                LEFT JOIN integration_systems s ON s.system_key = i.connector_source_system\n                WHERE i.created_at >= NOW() - INTERVAL '24 hours'\n                GROUP BY 1 HAVING COUNT(i.id) > 0\n                ORDER BY 2 DESC LIMIT 15",
     "format": "table"
    }
