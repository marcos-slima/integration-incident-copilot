# Copie para ".env" e ajuste conforme necessario. Nenhuma variavel
# aqui e obrigatoria para rodar em modo 100% local/demo (default) -
# ver app/config.py para a lista completa e os defaults reais.
# Para conferir a configuracao efetiva a qualquer momento (com
# segredos mascarados): uv run python -m app.config

# --- LLM Gateway (app/llm/factory.py) ---
# "ollama" (default, local-first, sem custo de API) | "openai" | "azure_openai"
LLM_PROVIDER=ollama

# LLM_ROUTE (DA-45) - opcional. Vazio (default) = comportamento de sempre,
# sem validacao adicional. Preenchido, o nome precisa existir em
# app/llm/routes.py::LLM_ROUTES e a ORIGIN REAL configurada precisa ter a
# mesma classe declarada pela rota; divergencia falha no BOOT.
# Rotas: local_lab | local_openai_server | openai_public |
#        self_hosted_openai | enterprise_azure
# LLM_ROUTE=local_lab
#
# "Qualquer modelo" e' LLM_MODEL (texto livre, acima/abaixo) e nao esta
# chave. Trocar de modelo Groq para o seu nao pede PR. Adicionar um
# FORNECEDOR pede uma entrada na tabela de rotas - de proposito, porque e'
# la que a pergunta "para onde o dado pode sair?" tem resposta. Um
# questionario de seguranca de cliente nao aceita "confio no rotulo".
#
# Hybrid Inference (DA-20) - opcional. Vazio (default) = sem fallback,
# comportamento identico a antes desta fase. Se preenchido ("openai",
# "azure_openai" ou "ollama"), o LLM Gateway tenta automaticamente este
# provider quando LLM_PROVIDER estiver indisponivel por falha de TRANSPORTE
# (Ollama fora do ar, timeout - nao erro de aplicacao).
# "ollama" aqui cobre o pedido mais comum de cliente: cloud primario, local
# no fallback - o dado degrada para dentro da infra em vez de o servico
# ficar indisponivel. Exige as credenciais do provider de fallback
# configuradas normalmente abaixo (OPENAI_API_KEY ou AZURE_OPENAI_*).
# LLM_FALLBACK_PROVIDER=openai

# Avaliacao externa (curto prazo, item 4) - timeouts explicitos, sem
# eles uma chamada LLM travada (nao caida) ou um pipeline lento na
# soma de varias etapas prendiam a requisicao indefinidamente.
# LLM_REQUEST_TIMEOUT_SECONDS=90.0
# DIAGNOSIS_TIMEOUT_SECONDS=180.0

# Ollama (usado quando LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3-coder-next:latest
EMBEDDING_MODEL=nomic-embed-text

# OpenAI / compativel (usado quando LLM_PROVIDER=openai) - so precisa
# se for usar este provedor
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Azure OpenAI (usado quando LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# AI Gateway (app/llm/gateway.py, DA-26) - circuit breaker, backoff e
# orçamento. Os defaults sao defensivos; mexa so se voce sabe o porque.
# LLM_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=60
# LLM_GATEWAY_BACKOFF_BASE_SECONDS=1.0
# LLM_GATEWAY_BACKOFF_MAX_SECONDS=30.0
# LLM_GATEWAY_MAX_COST_USD=0.5

# Loop ReAct (app/agent/nodes.py) - teto de recursao do agente que
# fecha o ciclo de ferramentas. Baixo demais corta o diagnostico no
# meio; alto demais deixa o agente girar ate estourar budget.
# REACT_AGENT_RECURSION_LIMIT=8

# --- Regra sobre o agente (DA-33) ---
# INVARIANTE: deixar ligado. A rule engine e deterministica e
# pre-filtra o LLM (21 regras SAP/integracao). Desligada, TODO request
# passa a depender do LLM — e quando ela casa, o diagnostico volta sem
# chamar o modelo nenhum, com prompt_digest/prompt_version NULL na
# resposta (DA-53): um diagnostico sem LLM nao foi produzido por
# prompt nenhum. So desligue para forcar o caminho do LLM em teste.
# RULE_ENGINE_ENABLED=true

# --- Circuit breaker dos conectores ---
# Mesma politica do AI Gateway, mas por conector externo: N falhas
# seguidas abrem o circuito e o conector passa a responder pelo
# fallback controlado em vez de estourar timeout a cada request.
# CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=
# CONNECTOR_CIRCUIT_COOLDOWN_SECONDS=30

# --- SAP RFC real (app/connectors/rfc_connector.py, use_real=True) ---
# So relevante com pyrfc + SAP NetWeaver RFC SDK instalados; modo
# demo/mock (default) nao le nada disto
# SAP_ASHOST=
# SAP_SYSNR=00
# SAP_CLIENT=100
# SAP_USER=
# SAP_PASSWORD=

# --- OData/CPI real (app/connectors/odata_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 client_credentials contra
# o token endpoint do CPI/Integration Suite + GET no servico OData real.
# ODATA_SERVICE_URL=
# ODATA_OAUTH_TOKEN_URL=
# ODATA_CLIENT_ID=
# ODATA_CLIENT_SECRET=

# --- ServiceNow (app/connectors/servicenow_connector.py) ---
# Vazio = modo demo/mock. Preenchido = chamadas HTTP reais contra a
# Table API do ServiceNow.
# SERVICENOW_INSTANCE_URL=https://suainstancia.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# --- Salesforce (app/connectors/salesforce_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials Flow
# (Connected App) + consulta SOQL via REST API.
# SALESFORCE_INSTANCE_URL=https://suaorg.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_API_VERSION=v61.0

# --- Workday (app/connectors/workday_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials Grant
# + REST API.
# WORKDAY_TENANT=
# WORKDAY_REST_BASE_URL=https://wd2-impl-services1.workday.com/ccx/api/v1/seutenant
# WORKDAY_CLIENT_ID=
# WORKDAY_CLIENT_SECRET=

# --- SAP Ariba / Business Network (app/connectors/ariba_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials + REST
# sobre status de pedido de compra na rede.
# ARIBA_OAUTH_TOKEN_URL=https://api.ariba.com/v2/oauth/token
# ARIBA_BASE_URL=
# ARIBA_CLIENT_ID=
# ARIBA_CLIENT_SECRET=

# --- SAP SuccessFactors Employee Central (app/connectors/successfactors_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials (SAP BTP
# Identity Authentication) + OData v2 em /PerPerson, com $expand de
# personalInfoNav/employmentNav/jobInfoNav.
# Nao testado contra um tenant real (sem acesso disponivel) — mesmo
# tratamento dos demais conectores reais nao verificados em producao.
# SFSF_OAUTH_TOKEN_URL=https://<tenant>.auth.us10.hana.ondemand.com/oauth/token
# SFSF_BASE_URL=https://<tenant>.successfactors.com
# SFSF_CLIENT_ID=
# SFSF_CLIENT_SECRET=

# --- Qdrant (RAG) ---
QDRANT_URL=http://127.0.0.1:6333

# --- GraphRAG / Neo4j (app/rag/graph_store.py) ---
# Desligado por default. Para ativar de verdade: (1) subir o Neo4j real
# ("docker compose --profile graphrag up -d neo4j") e (2)
# GRAPH_RAG_ENABLED=true aqui. Nao ha nada para descomentar no Python -
# so essa flag + a infra de fato existir.
GRAPH_RAG_ENABLED=false
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# Avaliacao externa (curto prazo, item 6): obrigatoria quando
# GRAPH_RAG_ENABLED=true - sem valor default fraco (nem aqui, nem no
# NEO4J_AUTH do docker-compose.yml, perfil "graphrag"). O app recusa
# subir (MissingGraphRagCredentialsError) se GRAPH_RAG_ENABLED=true e
# esta variavel ficar vazia.
# NEO4J_PASSWORD=

# --- Langfuse (observabilidade, opcional) ---
# Vazio = app roda normal, so sem tracing
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- API REST (/diagnose, app/main.py) ---
# Vazio (default) = uma chave e gerada automaticamente no startup e
# logada em nivel WARNING (DA-18) - o endpoint /diagnose nunca fica
# aberto sem chave, mas ela muda a cada restart. Preenchido = exige
# header "X-API-Key" com este valor (estavel entre restarts) em toda
# chamada a /diagnose.
# API_KEY=

# --- A2A (Agent2Agent, app/a2a/) ---
# Vazio (default) = uma chave e gerada automaticamente no startup e
# logada em nivel WARNING (DA-18) - o endpoint /a2a nunca fica aberto
# sem chave, mas ela muda a cada restart. Preenchido = exige header
# "X-A2A-Api-Key" com este valor (estavel entre restarts) em toda
# chamada a /a2a.
# A2A_API_KEY=
# Prefixo do seu endpoint, para o agent card anunciar uma URL ABSOLUTA
# — o spec A2A 0.3 exige "url" absoluta, nao um path relativo.
# Vazio = o card mantem o path relativo (fallback seguro em dev/teste).
# A2A_BASE_URL=https://copilot.empresa.com

# --- Event Mesh (DA-23, POST /events/incident, app/events/) ---
# Vazio (default) = uma chave e gerada automaticamente no startup e
# logada em nivel WARNING - o webhook nunca fica aberto sem chave, mas
# ela muda a cada restart. Preenchido = exige header
# "X-Event-Mesh-Api-Key" com este valor (estavel entre restarts) em
# toda chamada a /events/incident. Chave DEDICADA - nao reaproveita
# API_KEY/A2A_API_KEY, para isolar o blast radius de um webhook secret
# vazado (tipicamente configurado num sistema de monitoracao externo).
# EVENT_MESH_API_KEY=

# --- Redis (app/a2a/task_store.py) ---
# Vazio (default) = tasks A2A ficam so em memoria, perdidas a cada
# restart do processo (comportamento historico). Preenchido = tasks
# persistem no Redis apontado (sobrevive a restart). Avaliacao externa
# (medio prazo, item 2): "Persistencia de tasks A2A". O MESMO Redis
# tambem habilita a fila assincrona de diagnostico (medio prazo, item
# 6, ver app/queue.py) - POST /diagnose/async fica disponivel (503
# sem isso) e passa a exigir um worker RQ rodando para processar os
# jobs de verdade (docker compose --profile async up -d redis worker).
# Suba so o Redis local com "docker compose --profile async up -d redis".
# REDIS_URL=redis://127.0.0.1:6379/0
# Redis com autenticacao (A-12): defina REDIS_PASSWORD e use na URL
# REDIS_PASSWORD=troque-por-senha-forte
# REDIS_URL=redis://:troque-por-senha-forte@127.0.0.1:6379/0
# REDIS_BIND_IP=127.0.0.1   # Bind Redis apenas no loopback (padrao); 0.0.0.0 para acesso externo
# REDIS_HOST_PORT=6379       # Porta do Redis exposta no host

# --- Modo producao (avaliacao externa - curto prazo, item 1) ---
# false (default) = comportamento acima (chave efemera gerada
# automaticamente se API_KEY/A2A_API_KEY/EVENT_MESH_API_KEY estiverem
# vazios). true = o processo RECUSA subir se qualquer uma das 3 nao
# estiver configurada explicitamente - use em qualquer deploy que nao
# seja "clonar e rodar local", pra nao correr o risco de operar com
# uma chave efemera que muda a cada restart e so existe no log.
# REQUIRE_AUTH=false

# --- SAP CAP (app/connectors/cap_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OData v4 real + XSUAA (OAuth2
# Client Credentials, Basic Auth no token endpoint).
# CAP_SERVICE_URL=https://seu-app.cfapps.us10.hana.ondemand.com/odata/v4/po-approval/PurchaseOrderApprovals
# CAP_XSUAA_TOKEN_URL=https://seu-subaccount.authentication.us10.hana.ondemand.com/oauth/token
# CAP_CLIENT_ID=
# CAP_CLIENT_SECRET=

# --- SAP API Management (app/connectors/apimanagement_connector.py) ---
# AVISO: schema de resposta ESPECULATIVO, nao verificado contra API
# real - ver docstring do modulo antes de configurar contra tenant real.
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials real.
# APIM_ANALYTICS_URL=
# APIM_OAUTH_TOKEN_URL=
# APIM_CLIENT_ID=
# APIM_CLIENT_SECRET=

# Web search fallback (v1.1+)
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_THRESHOLD=0.6
# WEB_SEARCH_POLICY=approved  # disabled | approved | public_only
# SENSITIVITY_DEFAULT=confidential  # confidential | public (incidente sem dado real de conector)

# ---------------------------------------------------------------------------
# Governança de saída de dado (DA-43) — para onde vai um incidente CONFIDENCIAL
# ---------------------------------------------------------------------------
# Só com OS DOIS abaixo é que dado confidential pode ir para a nuvem
# (fail-closed):
#   1) DATA_SOVEREIGNTY_MODE=cloud_with_dlp
#   2) a ORIGIN de destino listada em CONFIDENTIAL_ALLOWED_ORIGINS
#
# Ponto central: a unidade de governança é a ORIGIN, não o nome do provider.
# 'openai' é só um rótulo de cliente: com OPENAI_BASE_URL vazio o dado vai
# para api.openai.com; com ela preenchida pode ir para vLLM, Groq, Gemini,
# LiteLLM. (No comparativo promptfoo, Gemini e Groq são AMBOS
# llm_provider=openai e só mudam OPENAI_BASE_URL.) Um questionário de
# segurança de cliente pergunta "para onde vai meu dado?" — e a resposta é
# uma URL, não um rótulo.
#
# Allowlist vazia = nenhum cloud recebe confidential; só providers locais.
# Consulte a matriz de decisão em vigor em `GET /llm/policy` (X-API-Key).
# DATA_SOVEREIGNTY_MODE=strict
# CONFIDENTIAL_ALLOWED_ORIGINS=https://api.openai.com,https://<recurso>.openai.azure.com
#
# LLM_SEND_SEED (DA-45) - tri-state, default = "consulte a tabela".
#   (vazio/ausente) consulta app/llm/capabilities.py, que decide pela ORIGIN
#                    real de destino - e a forma de DA-43 aplicada a
#                    capacidade, porque o fato e' do destino e nao do
#                    rotulo 'openai'
#   true / false   override explicito; sempre vence a tabela
#
# A invariante DA-2 (seed=42) continua o default: destino desconhecido
# recebe seed. O que a tabela remove sao os casos CONHECIDOS em que o campo
# e' recusado - o endpoint OpenAI-compatible do Gemini devolve 400
# "Unknown name \"seed\"" e nao ha fallback, a request inteira e recusada.
#
# Antes disto a chave era boolean GLOBAL, e desligar para o Gemini tirava
# o determinismo de todos os outros providers - era o que obrigava o eval a
# rodar com LLM_SEND_SEED=0 no processo inteiro. Se voce discover que um
# gateway seu recusa seed, use o override; nao desligue globalmente.
# LLM_SEND_SEED=true

# ---------------------------------------------------------------------------
# AMQP 1.0 — Solace Cloud / SAP Advanced Event Mesh (DA-32)
# Consumidor assíncrono de eventos de incidente.
# AMQP_ENABLED=false desabilita o consumidor sem remover a dependência.
# ---------------------------------------------------------------------------
# AMQP_ENABLED=false
# AMQP_HOST=mr-connection-xxxx.messaging.solace.cloud
# AMQP_PORT=5671
# AMQP_USERNAME=solace-cloud-client
# AMQP_PASSWORD=
# AMQP_QUEUE=integration/incidents
# AMQP_PREFETCH=1
# AMQP_RECONNECT_DELAY=5

# --- Observabilidade: PostgreSQL + Grafana (--profile observability) ---
# Necessario apenas ao subir: docker compose --profile observability up
# Escolha senhas fortes -- nao use os placeholders abaixo em producao.
# DATABASE_URL=postgresql+asyncpg://iic:SUA_SENHA_AQUI@127.0.0.1:5432/iic
# POSTGRES_PASSWORD=SUA_SENHA_AQUI
# GRAFANA_PASSWORD=SUA_SENHA_GRAFANA_AQUI
# Expor /metrics (Prometheus). Desligado por default: o endpoint e
# read-only e nao tem autenticacao propria, entao o proxy e quem
# decide quem enxerga.
# PROMETHEUS_ENABLED=false

# --- Admin: registro de modelos + metering (DA-46/47/48) ---
# Chave dedicada para /admin/* e a UI admin. Vazio = chave aleatoria
# efemera por processo (warning no log), nunca autenticacao desabilitada.
# ADMIN_API_KEY=

# Registro de modelos dirige o runtime (get_chat_model resolve modelo,
# base_url e chave do banco em vez do .env). Fail-closed: registry vazio
# p/ a origem rejeita a chamada.
# LLM_REGISTRY_DB=false

# Master key Fernet para as credenciais dos provedores em repouso
# (llm_credentials). Obrigatoria com LLM_REGISTRY_DB=true ou ao gravar
# credencial pelo /admin. Gere com: python -c "from cryptography.fernet
# import Fernet; print(Fernet.generate_key().decode())"
# LLM_CREDENTIALS_MASTER_KEY=

# Captura usage real (tokens) nas respostas LLM e persiste em llm_usage
# quando DATABASE_URL esta configurada. Best-effort, igual a incidents.
# METERING_ENABLED=true

# --- Relatorios agendados (reporter) ---
# REPORT_PERIOD=daily          # daily | weekly
# REPORT_OUTPUT=/app/reports   # mapeado para ./reports/ no host
