# Copie para ".env" e ajuste conforme necessario. Nenhuma variavel
# aqui e obrigatoria para rodar em modo 100% local/demo (default) -
# ver app/config.py para a lista completa e os defaults reais.
# Para conferir a configuracao efetiva a qualquer momento (com
# segredos mascarados): uv run python -m app.config

# --- LLM Gateway (app/llm/factory.py) ---
# "ollama" (default, local-first, sem custo de API) | "openai" | "azure_openai"
LLM_PROVIDER=ollama

# Ollama (usado quando LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:32b
EMBEDDING_MODEL=nomic-embed-text

# OpenAI / compativel (usado quando LLM_PROVIDER=openai) - so precisa
# se for usar este provedor
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Azure OpenAI (usado quando LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- SAP RFC real (app/connectors/rfc_connector.py, use_real=True) ---
# So relevante com pyrfc + SAP NetWeaver RFC SDK instalados; modo
# demo/mock (default) nao le nada disto
# SAP_ASHOST=
# SAP_SYSNR=00
# SAP_CLIENT=100
# SAP_USER=
# SAP_PASSWORD=

# --- OData/CPI real (app/connectors/odata_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 client_credentials contra
# o token endpoint do CPI/Integration Suite + GET no servico OData real.
# ODATA_SERVICE_URL=
# ODATA_OAUTH_TOKEN_URL=
# ODATA_CLIENT_ID=
# ODATA_CLIENT_SECRET=

# --- ServiceNow (app/connectors/servicenow_connector.py) ---
# Vazio = modo demo/mock. Preenchido = chamadas HTTP reais contra a
# Table API do ServiceNow.
# SERVICENOW_INSTANCE_URL=https://suainstancia.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# --- Salesforce (app/connectors/salesforce_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials Flow
# (Connected App) + consulta SOQL via REST API.
# SALESFORCE_INSTANCE_URL=https://suaorg.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_API_VERSION=v61.0

# --- Workday (app/connectors/workday_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials Grant
# + REST API.
# WORKDAY_TENANT=
# WORKDAY_REST_BASE_URL=https://wd2-impl-services1.workday.com/ccx/api/v1/seutenant
# WORKDAY_CLIENT_ID=
# WORKDAY_CLIENT_SECRET=

# --- SAP Ariba / Business Network (app/connectors/ariba_connector.py) ---
# Vazio = modo demo/mock. Preenchido = OAuth2 Client Credentials + REST
# sobre status de pedido de compra na rede.
# ARIBA_OAUTH_TOKEN_URL=https://api.ariba.com/v2/oauth/token
# ARIBA_BASE_URL=
# ARIBA_CLIENT_ID=
# ARIBA_CLIENT_SECRET=

# --- Qdrant (RAG) ---
QDRANT_URL=http://127.0.0.1:6333

# --- GraphRAG / Neo4j (app/rag/graph_store.py) ---
# Desligado por default. Para ativar de verdade: (1) subir o Neo4j real
# ("docker compose --profile graphrag up -d neo4j") e (2)
# GRAPH_RAG_ENABLED=true aqui. Nao ha nada para descomentar no Python -
# so essa flag + a infra de fato existir.
GRAPH_RAG_ENABLED=false
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Langfuse (observabilidade, opcional) ---
# Vazio = app roda normal, so sem tracing
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- A2A (Agent2Agent, app/a2a/) ---
# Vazio (default) = endpoint /a2a sem autenticacao (aceitavel so para
# portfolio/demo local - ver docs/proposals/a2a-interoperability-layer.md
# para o gap de producao documentado). Preenchido = exige header
# "X-A2A-Api-Key" com este valor em toda chamada a /a2a.
# A2A_API_KEY=
