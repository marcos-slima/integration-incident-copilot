{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: graph.py (caso IDoc travado)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": ["IDoc travado", "--interface", "rfc", "--id", "RFC-IDOC-51-DEMO", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (ServiceNow - alerta ITSM)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": [
        "Alerta ServiceNow aberto automaticamente",
        "--interface",
        "servicenow",
        "--id",
        "INC0010001",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (RFC - pool esgotado)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": [
        "Chamada RFC sincrona travando sob carga batch",
        "--interface",
        "rfc",
        "--id",
        "RFC-GWY-POOL-TIMEOUT-DEMO",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (Salesforce - Case sem sync SAP)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": [
        "Case Salesforce sobre pedido nao sincronizado com o SAP",
        "--interface",
        "salesforce",
        "--id",
        "SF-CASE-00847-DEMO",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (Workday - falha de sync SuccessFactors)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": [
        "Evento de integracao Workday falhou ao replicar dado do SuccessFactors",
        "--interface",
        "workday",
        "--id",
        "WD-SYNC-FAIL-DEMO",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (Ariba - PO bloqueado por fornecedor)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": [
        "Pedido de compra bloqueado na Ariba Network por divergencia de fornecedor",
        "--interface",
        "ariba",
        "--id",
        "ARIBA-PO-BLOCKED-DEMO",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: graph.py (texto livre)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.graph",
      "args": ["${input:incidentDescription}", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: pytest (tudo)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: pytest (so unitarios, rapido)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-m", "not integration", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: pytest (so A2A)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_a2a.py", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: pytest (so GraphRAG)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_graph_store.py", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Ver configuracao efetiva (app.config)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.config",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "incidentDescription",
      "type": "promptString",
      "description": "Descricao do incidente para debugar"
    }
  ]
}
