# DA-61: SKOS ontology for SAP integration error codes
# Version: 1.0.0
# Purpose: Provide machine-readable taxonomies for error classification
# Usage: Load via app/agent/ontology_loader.py → populates KNOWN_ERROR_RULES

@prefix ex: <http://example.org/iic/error_codes#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ============================================================================
# Top-level categories
# ============================================================================

ex:NetworkError a skos:Concept ;
    skos:prefLabel "Network Error"@en ;
    skos:altLabel "conexão falha", "timeout", "communication failure"@pt ;
    skos:inPolicy ex:ErrorClassification .

ex:AuthenticationError a skos:Concept ;
    skos:prefLabel "Authentication Error"@en ;
    skos:altLabel "auth falha", " acesso negado", "token inválido"@pt ;
    skos:inPolicy ex:ErrorClassification .

ex:AuthorizationError a skos:Concept ;
    skos:prefLabel "Authorization Error"@en ;
    skos:altLabel "permissão negada", "forbidden", "ACL violation"@pt ;
    skos:inPolicy ex:ErrorClassification .

ex:DataError a skos:Concept ;
    skos:prefLabel "Data Error"@en ;
    skos:altLabel "payload incorreto", "campo faltando", "schema mismatch"@pt ;
    skos:inPolicy ex:ErrorClassification .

ex:RateLimitError a skos:Concept ;
    skos:prefLabel "Rate Limit Error"@en ;
    skos:altLabel "too many requests", "quota excedida", "throttled"@pt ;
    skos:inPolicy ex:ErrorClassification .

ex:ParsingError a skos:Concept ;
    skos:prefLabel "Parsing Error"@en ;
    skos:altLabel "JSON inválido", "XML malformado", "EDI fail"@pt ;
    skos:inPolicy ex:ErrorClassification .

# ============================================================================
# Specific error codes ( mapped to KNOWN_ERROR_RULES )
# ============================================================================

# OAuth/Token errors
ex:OAuthTokenExpired a skos:Concept ;
    skos:prefLabel "OAuth Token Expired"@en ;
    skos:altLabel "token expirado", "access token invalid", "JWT expired"@pt ;
    skos:broader ex:AuthenticationError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: oauth.*token.*expir, token.*expir, access.?token.*invalid, JWT.*expir" ;
    skos:inPolicy ex:KnownErrorRules .

ex:OAuthTokenRefreshFailed a skos:Concept ;
    skos:prefLabel "OAuth Token Refresh Failed"@en ;
    skos:altLabel "refresh token fail", "token renewal error"@pt ;
    skos:broader ex:AuthenticationError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: refresh.*token.*fail, token.*renewal.*error" .

# Connection errors
ex:RFCCommunicationFailure a skos:Concept ;
    skos:prefLabel "RFC Communication Failure"@en ;
    skos:altLabel "RFC_COMMUNICATION_FAILURE", "network unreachable"@pt ;
    skos:broader ex:NetworkError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: rfc.*communication.*fail, network.*unreachable" .

ex:ConnectionRefused a skos:Concept ;
    skos:prefLabel "Connection Refused"@en ;
    skos:altLabel "connection refused", "connection reset", "ECONNREFUSED", "partner not reached"@pt ;
    skos:broader ex:NetworkError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: connection.*refus, connection.*rest, ECONNREFUSED, conex.*recus, partner.*not.*reached" .

ex:HTTPTimeout a skos:Concept ;
    skos:prefLabel "HTTP Timeout"@en ;
    skos:altLabel "timeout", "connection timeout", "deadline exceeded"@pt ;
    skos:broader ex:NetworkError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: timeout, connection.*timeout, deadline.*exceed" .

# Authentication/Authorization
ex:HTTP401Unauthorized a skos:Concept ;
    skos:prefLabel "HTTP 401 Unauthorized"@en ;
    skos:altLabel "401", "unauthorized", " authentication fail"@pt ;
    skos:broader ex:AuthenticationError ;
    ex:confidence 0.75 ;
    skos:note "Patterns: 401.*unauthorized, unauthorized.*access, authentication.*fail" .

ex:HTTP403Forbidden a skos:Concept ;
    skos:prefLabel "HTTP 403 Forbidden"@en ;
    skos:altLabel "403", "forbidden", "ACL violation"@pt ;
    skos:broader ex:AuthorizationError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: 403.*forbidden, forbidden.*access, ACL.*violat" .

# Data errors
ex:SAPDataElementNotFound a skos:Concept ;
    skos:prefLabel "SAP Data Element Not Found"@en ;
    skos:altLabel "DATA_ELEMENT_NOT_FOUND", " campo inexistente", "field not in schema"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: dataelement.*not.*found, data element.*not.*found, field.*not.*in.*schema" .

ex:MDIValidationFailed a skos:Concept ;
    skos:prefLabel "MDI Validation Failed"@en ;
    skos:altLabel "MDI_VALIDATION_FAILED", "validation fail", "schema mismatch"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: mdi.*validation.*fail, validation.*fail, schema.*mismatch" .

# Rate limiting
ex:HTTP429TooManyRequests a skos:Concept ;
    skos:prefLabel "HTTP 429 Too Many Requests"@en ;
    skos:altLabel "429", "too many requests", "rate limit", "throttled"@pt ;
    skos:broader ex:RateLimitError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: 429.*too.*many.*request, rate.*limit, throttled" .

# Parsing errors
ex:JSONParsingError a skos:Concept ;
    skos:prefLabel "JSON Parsing Error"@en ;
    skos:altLabel "JSON parse fail", "invalid JSON", "JSON syntax error"@pt ;
    skos:broader ex:ParsingError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: json.*parse.*fail, invalid JSON, JSON.*syntax.*error" .

ex:XMLParsingError a skos:Concept ;
    skos:prefLabel "XML Parsing Error"@en ;
    skos:altLabel "XML parse fail", "malformed XML", "XML syntax error"@pt ;
    skos:broader ex:ParsingError ;
    ex:confidence 0.85 ;
    skos:note "Patterns: xml.*parse.*fail, malformed XML, XML.*syntax.*error" .

# ============================================================================
# Policy rules ( mapped to next_steps and categories )
# ============================================================================

ex:Recoverable a skos:Concept ;
    skos:prefLabel "Recoverable Error"@en ;
    skos:altLabel "recuperável", "retryable", "transient"@pt ;
    skos:inPolicy ex:ErrorSeverity .

ex:NonRecoverable a skos:Concept ;
    skos:prefLabel "Non-Recoverable Error"@en ;
    skos:altLabel "não recuperável", "permanent", "fatal"@pt ;
    skos:inPolicy ex:ErrorSeverity .

ex:EscalateTier1 a skos:Concept ;
    skos:prefLabel "Escalate Tier 1"@en ;
    skos:altLabel "tier 1", "operation team", "first line"@pt ;
    skos:inPolicy ex:EscalationPolicy .

ex:EscalateTier2 a skos:Concept ;
    skos:prefLabel "Escalate Tier 2"@en ;
    skos:altLabel "tier 2", "development team", "second line"@pt ;
    skos:inPolicy ex:EscalationPolicy .

ex:EscalateTier3 a skos:Concept ;
    skos:prefLabel "Escalate Tier 3"@en ;
    skos:altLabel "tier 3", "vendor support", "third line"@pt ;
    skos:inPolicy ex:EscalationPolicy .

# ============================================================================
# Error classification policy
# ============================================================================

ex:ErrorClassification a skos:Collection ;
    skos:member ex:NetworkError ;
    skos:member ex:AuthenticationError ;
    skos:member ex:AuthorizationError ;
    skos:member ex:DataError ;
    skos:member ex:RateLimitError ;
    skos:member ex:ParsingError ;
    skos:prefLabel "Error Classification Hierarchy"@en .

ex:KnownErrorRules a skos:Collection ;
    skos:member ex:OAuthTokenExpired ;
    skos:member ex:OAuthTokenRefreshFailed ;
    skos:member ex:RFCCommunicationFailure ;
    skos:member ex:ConnectionRefused ;
    skos:member ex:HTTPTimeout ;
    skos:member ex:HTTP401Unauthorized ;
    skos:member ex:HTTP403Forbidden ;
    skos:member ex:SAPDataElementNotFound ;
    skos:member ex:MDIValidationFailed ;
    skos:member ex:HTTP429TooManyRequests ;
    skos:member ex:JSONParsingError ;
    skos:member ex:XMLParsingError ;
    skos:member ex:sap_material_lock ;
    skos:member ex:sap_pricing_condition_missing ;
    skos:member ex:sap_idoc_status_51 ;
    skos:member ex:sap_idoc_status_26 ;
    skos:member ex:HTTP503Unavailable ;
    skos:member ex:cpi_mapping_error ;
    skos:member ex:ssl_certificate_expired ;
    skos:member ex:rfc_destination_error ;
    skos:member ex:duplicate_document ;
    skos:member ex:sap_idoc_multiple_objects ;
    skos:member ex:sap_idoc_port_partner ;
    skos:member ex:sap_badi_exception ;
    skos:member ex:sap_bapi_failure ;
    skos:member ex:sap_serial_number_duplicate ;
    skos:member ex:sap_sd_credit_block ;
    skos:member ex:SAPMDGMdiLock ;
    skos:prefLabel "Known Error Rules Ontology"@en .

ex:ErrorSeverity a skos:Collection ;
    skos:member ex:Recoverable ;
    skos:member ex:NonRecoverable ;
    skos:prefLabel "Error Severity Levels"@en .

ex:EscalationPolicy a skos:Collection ;
    skos:member ex:EscalateTier1 ;
    skos:member ex:EscalateTier2 ;
    skos:member ex:EscalateTier3 ;
    skos:prefLabel "Escalation Policy Levels"@en .

# ============================================================================
# Additional error codes (mapped from KNOWN_ERROR_RULES)
# ============================================================================

ex:sap_material_lock a skos:Concept ;
    skos:prefLabel "SAP Material Lock"@en ;
    skos:altLabel "material lock", "M8082", "material bloqueado"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: M8082, material.*lock, material.*bloqueado, ENQUEUE.*material" ;
    skos:note "next_steps: Aguardar 15 minutos e tentar o reprocessamento, Verificar transação SM12 (SAP Lock Monitor) para identificar o processo bloqueador, Confirmar se há um job batch em execução no mesmo material, Se o lock for antigo (> 1h), verificar com o administrador SAP se pode ser liberado" ;
    skos:member ex:Recoverable .

ex:sap_pricing_condition_missing a skos:Concept ;
    skos:prefLabel "SAP Pricing Condition Missing"@en ;
    skos:altLabel "condition record missing", "VK041", "preço ausente"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: VK041, condition.*record.*missing, condicao.*preco.*ausente, no.*pricing.*condition, MM.*price.*not.*found" ;
    skos:note "next_steps: Verificar tabela T001W para configuração de.preço, Revisar transação VK04 para criar/mantener condição, Confirmar data de validade da condição, Verificar condições de desconto e promoções vigentes" ;
    skos:member ex:Recoverable .

ex:sap_idoc_status_51 a skos:Concept ;
    skos:prefLabel "SAP IDoc Status 51"@en ;
    skos:altLabel "IDoc status 51", "application error", "WE19 status 51"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: IDoc.*status.*51, status.*51.*IDoc, IDOC.*APPLICATION.*ERROR, WE19.*status.*51" ;
    skos:note "next_steps: Acessar transação BD87 para reprocessar o IDoc, Verificar logs de erro no WE19 para detalhes do problema, Confirmar se o programa de processamento está ativo, Revisar configuração de partner profile no NAST" ;
    skos:member ex:NonRecoverable .

ex:sap_idoc_status_26 a skos:Concept ;
    skos:prefLabel "SAP IDoc Status 26"@en ;
    skos:altLabel "IDoc status 26", "syntax error", "ALE error"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: IDoc.*status.*26, status.*26.*IDoc, IDOC.*ALE.*ERROR" ;
    skos:note "next_steps: Verificar estrutura do segmento E1MARAM no IDoc, Confirmar se o schema está atualizado no WE60, Revisar transação BD87 para reprocessamento, Validar partner profile e port configuration" ;
    skos:member ex:NonRecoverable .

ex:HTTP503Unavailable a skos:Concept ;
    skos:prefLabel "HTTP 503 Unavailable"@en ;
    skos:altLabel "503", "service unavailable", "backend unavailable"@pt ;
    skos:broader ex:NetworkError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: HTTP.*503, 503.*Service.*Unavailable, service.*unavailable, backend.*unavailable, system.*unavailable" ;
    skos:note "next_steps: Aguardar 60 segundos e tentar reprocessamento, Verificar status do backend SAP (SM51, SM66), Confirmar se o serviço OData/RFC está ativo, Revisar logs de sistema para erro de resource exhausted" ;
    skos:member ex:Recoverable .

ex:cpi_mapping_error a skos:Concept ;
    skos:prefLabel "CPI Mapping Error"@en ;
    skos:altLabel "mapping failed", "XSLT error", "groovy error"@pt ;
    skos:broader ex:ParsingError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: MAPPING_FAIL, mapping.*failed, xslt.*error, XSLT_PARS, groovy.*script.*error, script.*exception.*iflow" ;
    skos:note "next_steps: Acessar CPI Cockpit para visualizar o erro de mapping, Revisar mapping diagram ou script Groovy, Validar input XML com schema XSD, Confirmar se o iFlow está ativado" ;
    skos:member ex:NonRecoverable .

ex:ssl_certificate_expired a skos:Concept ;
    skos:prefLabel "SSL Certificate Expired"@en ;
    skos:altLabel "certificate expired", "SSL expired", "PKIX path failed"@pt ;
    skos:broader ex:AuthenticationError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: certificate.*expired, SSL.*expired, certificado.*expirado, certificado\\s+(?:ssl|tls|x\\.?509)\\b.*expir, PKIX.*path.*build.*failed, unable.*find.*valid.*certification, SSL.*handshake.*fail" ;
    skos:note "next_steps: Renovar certificado SSL/TLS no keystore SAP (strustSAP2), Importar certificado da CA raiz no trust store, Revisar data de validade do certificado (SMICM), Confirmar se o hostname corresponde ao certificado" ;
    skos:member ex:Recoverable .

ex:rfc_destination_error a skos:Concept ;
    skos:prefLabel "RFC Destination Error"@en ;
    skos:altLabel "RFC destination not found", "RFC logon failed", "ABAP RFC error"@pt ;
    skos:broader ex:NetworkError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: RFC.*destination.*not.*found, destination.*not.*found, RFC.*logon.*failed, RFC.*connection.*failed, ABAP.*RFC.*error" ;
    skos:note "next_steps: Verificar transação SM59 para configurar destination RFC, Confirmar usuário, senha e language no destination, Revisar host e system number no destination, Testar conexão com botão 'Test Connection'" ;
    skos:member ex:Recoverable .

ex:duplicate_document a skos:Concept ;
    skos:prefLabel "Duplicate Document"@en ;
    skos:altLabel "duplicate entry", "unique constraint", "document already posted"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: duplicate.*entry, unique.*constraint, already.*exist, \\bj[aá]\\s+existe, document.*already.*posted, FI.*duplicate.*document" ;
    skos:note "next_steps: Verificar número do documento e data de posting, Revisar transação FB03 para documentos já existentes, Confirmar se o documento foi duplicado por reprocessamento, Ajustar documento original ou cancelar duplicated" ;
    skos:member ex:NonRecoverable .

ex:sap_idoc_multiple_objects a skos:Concept ;
    skos:prefLabel "SAP IDoc Multiple Objects"@en ;
    skos:altLabel "IDoc multiple objects", "IDoc error multile"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: IDOC_ERROR_MULTIPLE_OBJECTS, multiple.*objects.*idoc, idoc.*multiple.*objects" ;
    skos:note "next_steps: Verificar IDoc no WE02/WE05 para objetos múltiplos, Confirmar se há mais de um documento com mesmo identifier, Revisar lógica de mapping na interface, Verificar se o partner profile está configurado corretamente" ;
    skos:member ex:NonRecoverable .

ex:sap_idoc_port_partner a skos:Concept ;
    skos:prefLabel "SAP IDoc Port Partner"@en ;
    skos:altLabel "IDoc status 68", "port not found", "partner port not found"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: IDoc.*status.*68, status.*68.*IDoc, IDOC.*SYNTAX.*ERROR.*SENDER, port.*not.*found.*partner, \\bporta?\\b.*n[aã]o.*encontrad, PARTNER.*PORT.*NOT.*FOUND" ;
    skos:note "next_steps: Verificar portas configuradas no transactionWE20, Confirmar partner number e partner type no IDoc, Revisar message type e port assignment, Testar com IDoc de teste simples" ;
    skos:member ex:NonRecoverable .

ex:sap_badi_exception a skos:Concept ;
    skos:prefLabel "SAP BAdI Exception"@en ;
    skos:altLabel "BAdI exception", "enhancement spot exception", "CX_BADI"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: BAdI.*exception, BAdi.*error, enhancement.*spot.*exception, IF_EX_.*=>.*exception, CX_BADI" ;
    skos:note "next_steps: Visualizar stack trace no transaction SE37/SE18 para detalhes da exception, Confirmar se a implementação BAdI está ativa, Revisar código da implementação para erros lógicos, Verificar transação SE18 para definir filter value, Acessartransaction ST22 para análise de dump" ;
    skos:member ex:NonRecoverable .

ex:sap_bapi_failure a skos:Concept ;
    skos:prefLabel "SAP BAPI Failure"@en ;
    skos:altLabel "BAPI return E", "BAPI failure", "BAPI error"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: BAPI.*RETURN.*E\\b, BAPI.*failure, BAPI.*error, BAPIRET.*TYPE.*E, BAPI_FAILURE, bapi.*retornou.*erro" ;
    skos:note "next_steps: Verificar mensagem de erro na table BAPIRET2, Confirmar se os parâmetros de input estão corretos, Revisar logs de aplicação SAP para detalhes, Validar rules de negócio antes de chamada do BAPI" ;
    skos:member ex:NonRecoverable .

ex:sap_serial_number_duplicate a skos:Concept ;
    skos:prefLabel "SAP Serial Number Duplicate"@en ;
    skos:altLabel "serial duplicate", "serial already assigned", "MM60 serial"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: serial.*number.*duplicate, numero.*serie.*duplicado, serial.*already.*assigned, SERIALNR.*ALREADY, MM60.*serial, duplicate.*serial" ;
    skos:note "next_steps: Verificar número de série no transaction IW31/IW32, Confirmar se o material permite serial numbers (MATMAS), Revisar transação IR01 para entrada de serial, Ajustar número de série ou usar número disponível, Verificar transação IQ03 para visualizar serial" ;
    skos:member ex:NonRecoverable .

ex:sap_sd_credit_block a skos:Concept ;
    skos:prefLabel "SAP SD Credit Block"@en ;
    skos:altLabel "credit block", "VKM1", "credit limit exceeded"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: credit.*block, bloqueio.*credito, credit.*limit.*exceeded, limite.*credito.*excedido, VKM1, RVKRED, credit.*check.*failed" ;
    skos:note "next_steps: Verificar transação VKM1 para bloqueios de crédito, Confirmar limites de crédito no customer master (FD02), Revisar análise de crédito no sales order, Aprovar liberação de crédito ou ajustar pedido, Visualizar detalhes no transaction FD32" ;
    skos:member ex:Recoverable .

ex:SAPMDGMdiLock a skos:Concept ;
    skos:prefLabel "SAP MDG/MDI Lock"@en ;
    skos:altLabel "MDG lock", "MDI failure", "master data governance"@pt ;
    skos:broader ex:DataError ;
    ex:confidence 0.90 ;
    skos:note "Patterns: MDG.*lock, MDI.*replicate.*fail, master.*data.*governance.*error, MDG.*error, MDI.*error, master.*data.*integration.*fail, BP.*lock.*governance" ;
    skos:note "next_steps: Verificar transação MDG_MDM_UI para locks no MDG, Confirmar se há job de replicate em execução, Revisar logs de MDI para detalhes do erro, Ajustar configuração de governance ou aguardar liberação" ;
    skos:member ex:Recoverable .
