        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "definition": "SELECT DISTINCT agent_domain FROM incidents WHERE agent_domain IS NOT NULL ORDER BY 1",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "agent_domain",
        "options": [],
        "query": "SELECT DISTINCT agent_domain FROM incidents WHERE agent_domain IS NOT NULL ORDER BY 1",
        "refresh": 2,
