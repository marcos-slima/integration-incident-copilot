{
  "__inputs": [],
  "__requires": [],
  "annotations": {"list": []},
  "description": "iPaaS — Saúde dos Conectores e Plataforma: interfaces, circuit breakers, LLM providers e latência",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Interfaces Únicas (7d)",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT COUNT(DISTINCT interface_type) as value FROM incidents WHERE created_at >= NOW() - INTERVAL '7 days' AND interface_type IS NOT NULL",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Fallbacks LLM",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT COUNT(*) as value FROM incidents WHERE $__timeFilter(created_at) AND llm_provider_used LIKE '%fallback%'",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 60},
            {"color": "green", "value": 80}
          ]},
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Confiança Média Modelo (%)",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT ROUND(AVG(model_confidence) * 100, 1) as value FROM incidents WHERE $__timeFilter(created_at) AND model_confidence IS NOT NULL",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 10000},
            {"color": "red", "value": 30000}
          ]},
          "unit": "ms"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Latência P95 (ms)",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT ROUND(PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latency_ms)) as value FROM incidents WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Evidências HIGH/CRITICAL",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT COUNT(*) as value FROM incidents WHERE $__timeFilter(created_at) AND evidence_strength IN ('high', 'critical')",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 6,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Volume por Interface (interface_type)",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), interface_type, COUNT(*) as value FROM incidents WHERE $__timeFilter(created_at) AND interface_type IS NOT NULL AND ($interface_type = 'All' OR interface_type = ANY(string_to_array('$interface_type', ','))) GROUP BY 1, 2 ORDER BY 1",
        "format": "time_series"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {"unit": "ms", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 7,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Latência Mediana por LLM Provider",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), llm_provider_used, PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY latency_ms) as value FROM incidents WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL AND llm_provider_used IS NOT NULL AND ($llm_provider = 'All' OR llm_provider_used = ANY(string_to_array('$llm_provider', ','))) GROUP BY 1, 2 ORDER BY 1",
        "format": "time_series"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "id": 8,
      "options": {"orientation": "horizontal", "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Diagnósticos por LLM Provider",
      "type": "barchart",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT llm_provider_used as provider, COUNT(*) as count FROM incidents WHERE $__timeFilter(created_at) AND llm_provider_used IS NOT NULL GROUP BY 1 ORDER BY 2 DESC",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "id": 9,
      "options": {"orientation": "horizontal", "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Top 10 Interfaces por Latência Mediana",
      "type": "barchart",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT interface_type, PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY latency_ms) as median_latency FROM incidents WHERE $__timeFilter(created_at) AND latency_ms IS NOT NULL AND interface_type IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "id": 10,
      "options": {"pieType": "donut", "legend": {"displayMode": "list", "placement": "right"}},
      "title": "Distribuição Força de Evidência",
      "type": "piechart",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT evidence_strength as metric, COUNT(*) as value FROM incidents WHERE $__timeFilter(created_at) AND evidence_strength IS NOT NULL GROUP BY 1",
        "format": "table"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "id": 11,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Confiança do Modelo ao Longo do Tempo (avg/min/max)",
      "type": "timeseries",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), AVG(model_confidence) as \"Média\", MIN(model_confidence) as \"Mínima\", MAX(model_confidence) as \"Máxima\" FROM incidents WHERE $__timeFilter(created_at) AND model_confidence IS NOT NULL GROUP BY 1 ORDER BY 1",
        "format": "time_series"
      }]
    },
    {
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "id"}, "properties": [{"id": "displayName", "value": "ID"}]},
          {"matcher": {"id": "byName", "options": "interface_type"}, "properties": [{"id": "displayName", "value": "Interface"}]},
          {"matcher": {"id": "byName", "options": "llm_provider_used"}, "properties": [{"id": "displayName", "value": "LLM Provider"}]},
          {"matcher": {"id": "byName", "options": "latency_ms"}, "properties": [{"id": "displayName", "value": "Latência (ms)"}]},
          {"matcher": {"id": "byName", "options": "model_confidence"}, "properties": [{"id": "displayName", "value": "Confiança"}]},
          {"matcher": {"id": "byName", "options": "evidence_strength"}, "properties": [{"id": "displayName", "value": "Evidência"}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "id": 12,
      "options": {"sortBy": [{"displayName": "Criado Em", "desc": true}]},
      "title": "Últimos 20 Incidentes — Visão iPaaS",
      "type": "table",
      "targets": [{
        "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres_iic"},
        "rawSql": "SELECT LEFT(id::text, 8) as id, created_at as \"Criado Em\", interface_type, connector_source_system as sistema, llm_provider_used, latency_ms, model_confidence, evidence_strength FROM incidents WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 20",
        "format": "table"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["iic", "ipaas", "integration", "sap", "connector", "llm"],
